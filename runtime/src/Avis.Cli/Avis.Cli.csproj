<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>avis-cli</AssemblyName>
    <!-- Match the app runtime: no tiered-JIT promotion stalls in benches (D-022). -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Avis.Core\Avis.Core.csproj" />
    <ProjectReference Include="..\Avis.Render\Avis.Render.csproj" />
    <ProjectReference Include="..\Avis.Audio\Avis.Audio.csproj" />
  </ItemGroup>
</Project>
