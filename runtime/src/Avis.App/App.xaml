<?xml version="1.0" encoding="utf-8"?>
<!-- Merges the WinUI control styles (XamlControlsResources). This must happen through
     XAML: adding the same dictionary from code throws inside the framework on Windows
     App SDK 2.6, and without it every themed control fails to parse (D-023). -->
<Application
    x:Class="Avis.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
