<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Avis.App</RootNamespace>
    <AssemblyName>Avis.App</AssemblyName>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>AVIS</Product>
    <Company>AVIS</Company>
    <Description>Neural audio visualizer for Windows</Description>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Realtime analysis: tiered JIT promotion showed up as 40-100 ms
         analysis stalls in a 3 s bench; full-quality JIT from the start (D-022). -->
    <TieredCompilation>false</TieredCompilation>
    <!-- Program.cs provides Main; the XAML compiler would otherwise generate one. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Avis.Core\Avis.Core.csproj" />
    <ProjectReference Include="..\Avis.Render\Avis.Render.csproj" />
    <ProjectReference Include="..\Avis.Audio\Avis.Audio.csproj" />
  </ItemGroup>
  <!-- The build generates the PRI index (app resources + the WinUI resource maps
       referenced by App.xaml) but the SDK does not copy it to the publish folder.
       Without it WinUI cannot load the control styles and the app dies with
       0xC000027B on the first themed control (D-023). -->
  <Target Name="PublishPriIndex" AfterTargets="Publish"
          Condition="'$(PublishDir)' != '' and Exists('$(TargetDir)$(AssemblyName).pri')">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
